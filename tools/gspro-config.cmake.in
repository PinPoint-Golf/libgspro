#
# find_package(gspro CONFIG) yields the SAME gspro::gspro target that
# add_subdirectory() does, so a consumer (PinPoint Studio, design §11 package 8)
# need not know which way the library arrived.
@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/gsproTargets.cmake")

check_required_components(gspro)
