#
# The OPTIONAL .gswire container and replay (design §7), installed only when
# GS_BUILD_RECORD built it.
#
# ⚠ A SEPARATE MODULE BECAUSE LINKING IT IS THE EXCEPTION.  `pkg-config --libs
# gspro` must not drag file I/O into a host that keeps its captures somewhere
# else; a consumer that wants this one asks for it by name.
prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: gspro-record
Description: @PROJECT_DESCRIPTION@ — .gswire recorder and replay
Version: @PROJECT_VERSION@
Requires: gspro
Libs: -L${libdir} -lgspro_record
Cflags: -I${includedir}
